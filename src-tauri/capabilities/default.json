{
  "identifier": "default",
  "description": "Default permissions for LumenX Studio",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "updater:default",
    "process:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
